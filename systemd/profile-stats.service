[Unit]
Description=Refresh the shipping stats on the GitHub profile README

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# A run missed while katana was off fires at boot, possibly before the network is up, so retry the fetch.
ExecStartPre=/bin/sh -c 'for try in 1 2 3 4 5 6; do git -C %h/.local/share/profile-stats/snnbotchway fetch --quiet origin main && exit 0; sleep 20; done; exit 1'
ExecStartPre=/usr/bin/git -C %h/.local/share/profile-stats/snnbotchway reset --quiet --hard origin/main
ExecStart=%h/.local/share/profile-stats/snnbotchway/stats/update.sh
